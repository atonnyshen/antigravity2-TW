  "dynamicRules": [
    {
      "id": "offload-routine-steps-faster-executor-full",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?faster executor\\.\\s*Same\\s+quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "zhPeriod" },
      "sc": "将常规步骤分流至更快的执行模型。保持同等质量，消耗更少 Token{1}",
      "tw": "將例行步驟分流至更快的執行模型。維持相同品質，消耗更少 Token{1}"
    },
    {
      "id": "offload-routine-steps-model-quality-full",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?(.+?)\\.\\s*Same\\s+(.+?)(?:-level)?\\s+quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "trim", "3": "zhPeriod" },
      "sc": "将常规步骤分流至 {1}。保持 {2} 同级质量，消耗更少 Token{3}",
      "tw": "將例行步驟分流至 {1}。維持 {2} 同級品質，消耗更少 Token{3}"
    },
    {
      "id": "offload-routine-steps-faster-executor-short",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?faster executor(\\.?)$",
      "flags": "i",
      "transforms": { "1": "zhPeriod" },
      "sc": "将常规步骤分流至更快的执行模型{1}",
      "tw": "將例行步驟分流至更快的執行模型{1}"
    },
    {
      "id": "offload-routine-steps-short",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?(.+?)(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "zhPeriod" },
      "sc": "将常规步骤分流至 {1}{2}",
      "tw": "將例行步驟分流至 {1}{2}"
    },
    {
      "id": "same-quality-fewer-tokens",
      "pattern": "^Same quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "zhPeriod" },
      "sc": "保持同等质量，消耗更少 Token{1}",
      "tw": "維持相同品質，消耗更少 Token{1}"
    },
    {
      "id": "model-may-offload-quality-full",
      "pattern": "^(.+?)\\s+that may offload routine steps to\\s+(.+?)\\.\\s*Same\\s+(.+?)-level quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "trim", "3": "trim", "4": "zhPeriod" },
      "sc": "{1} 可将例行步骤分流至 {2}。维持 {3} 同级质量，消耗更少 Token{4}",
      "tw": "{1} 可將例行步驟分流至 {2}。維持 {3} 同級品質，消耗更少 Token{4}"
    },
    {
      "id": "model-may-offload-short",
      "pattern": "^(.+?)\\s+that may offload routine steps to\\s+(.+?)(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "trim", "3": "zhPeriod" },
      "sc": "{1} 可将例行步骤分流至 {2}{3}",
      "tw": "{1} 可將例行步驟分流至 {2}{3}"
    },
    {
      "id": "same-model-level-quality",
      "pattern": "^Same\\s+(.+?)-level quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "zhPeriod" },
      "sc": "维持 {1} 同级质量，消耗更少 Token{2}",
      "tw": "維持 {1} 同級品質，消耗更少 Token{2}"
    },
    {
      "id": "detached-at-sha",
      "pattern": "^Detached at\\s+([0-9a-f]{6,40})$",
      "flags": "i",
      "sc": "已分离于 {1}",
      "tw": "已分離於 {1}"
    },
    {
      "id": "voice-speed",
      "pattern": "^Voice\\s+speed,\\s+(.+)$",
      "flags": "i",
      "sc": "语速，{1}",
      "tw": "語速，{1}"
    },
    {
      "id": "couldn-t-disconnect",
      "pattern": "^Couldn['’]t disconnect\\s+(.+?):\\s*(.+)$",
      "flags": "i",
      "sc": "无法断开 {1} 的连接：{2}",
      "tw": "無法中斷 {1} 的連線：{2}"
    },
    {
      "id": "failed-to-load-page",
      "pattern": "^Failed to load page\\s+(.+?):\\s*(.+)$",
      "flags": "i",
      "sc": "加载页面 {1} 失败：{2}",
      "tw": "載入頁面 {1} 失敗：{2}"
    },
    {
      "id": "more-options-for",
      "pattern": "^More options for\\s+(.+)$",
      "flags": "i",
      "sc": "{1} 的更多选项",
      "tw": "{1} 的更多選項"
    },
    {
      "id": "opens-new-conv-screen",
      "pattern": "^Opens the New Conversation screen for this\\s+(.+)$",
      "flags": "i",
      "transforms": { "1": "lookupOrKeep" },
      "sc": "打开此 {1} 的新会话界面",
      "tw": "開啟此 {1} 的新對話畫面"
    },
    {
      "id": "plus-n-attachments",
      "pattern": "^\\+(\\d+)\\s+attachments?$",
      "flags": "i",
      "sc": "另有 {1} 个附件",
      "tw": "另有 {1} 個附件"
    },
    {
      "id": "branch-current",
      "pattern": "^Branch,\\s*current:\\s*(.+)$",
      "flags": "i",
      "sc": "当前分支：{1}",
      "tw": "目前分支：{1}"
    },
    {
      "id": "github-prefix",
      "pattern": "^GitHub:\\s*(.+)$",
      "flags": "i",
      "sc": "GitHub：{1}",
      "tw": "GitHub：{1}"
    },
    {
      "id": "ssh-prefix",
      "pattern": "^SSH:\\s*(.+)$",
      "flags": "i",
      "sc": "SSH：{1}",
      "tw": "SSH：{1}"
    },
    {
      "id": "script-timed-out",
      "pattern": "^script timed out after\\s+(\\d+)\\s*ms$",
      "flags": "i",
      "sc": "脚本于 {1} 毫秒后超时",
      "tw": "指令碼於 {1} 毫秒後逾時"
    },
    {
      "id": "select-model-current",
      "pattern": "^Select model,\\s*current:\\s*(.+)$",
      "flags": "i",
      "sc": "选择模型，当前：{1}",
      "tw": "選擇模型，目前：{1}"
    },
    {
      "id": "select-project-current",
      "pattern": "^Select project,\\s*current:\\s*(.+)$",
      "flags": "i",
      "sc": "选择项目，当前：{1}",
      "tw": "選擇專案，目前：{1}"
    },
    {
      "id": "stop-n-selected",
      "pattern": "^Stop\\s+(\\d+)\\s+selected$",
      "flags": "i",
      "sc": "停止已选中的 {1} 个项目",
      "tw": "停止已選取的 {1} 個項目"
    },
    {
      "id": "available-for-project",
      "pattern": "^Available for\\s+(.+?)\\s+project$",
      "flags": "i",
      "transforms": { "1": "trim" },
      "sc": "适用于 {1} 项目",
      "tw": "適用於 {1} 專案"
    },
    {
      "id": "all-permissions-will-be-revoked",
      "pattern": "^All (.+?) will be revoked\\. The plugin will ask before doing this again\\.$",
      "flags": "",
      "sc": "将撤销全部 {1}。插件在再次执行此操作前会先征求您的同意。",
      "tw": "將撤銷全部 {1}。外掛程式在再次執行此操作前會先徵求您的同意。"
    },
    {
      "id": "dismiss-target",
      "pattern": "^Dismiss:\\s*(.+)$",
      "flags": "",
      "sc": "忽略：{1}",
      "tw": "關閉：{1}"
    },
    {
      "id": "move-to-dest",
      "pattern": "^Move to\\s+(.+)$",
      "flags": "",
      "transforms": { "1": "lookupOrKeep" },
      "sc": "移动到 {1}",
      "tw": "移至 {1}"
    },
    {
      "id": "no-matching-languages-for",
      "pattern": "^No matching languages for \"(.+)\"$",
      "flags": "",
      "sc": "未找到与“{1}”匹配的语言",
      "tw": "找不到與「{1}」相符的語言"
    },
    {
      "id": "remove-from-target",
      "pattern": "^Remove from\\s+(.+)$",
      "flags": "",
      "transforms": { "1": "lookupOrKeep" },
      "sc": "从 {1} 移除",
      "tw": "從 {1} 移除"
    },
    {
      "id": "revoke-all-target",
      "pattern": "^Revoke all:\\s*(.+)$",
      "flags": "",
      "sc": "全部撤销：{1}",
      "tw": "全部撤銷：{1}"
    },
    {
      "id": "revoke-one-target",
      "pattern": "^Revoke:\\s*(.+)$",
      "flags": "",
      "sc": "撤销：{1}",
      "tw": "撤銷：{1}"
    },
    {
      "id": "your-plan-value",
      "pattern": "^Your plan:\\s*(.+)$",
      "flags": "i",
      "sc": "您的方案：{1}",
      "tw": "您的方案：{1}"
    },
    {
      "id": "telemetry-off-account",
      "pattern": "^Telemetry is turned off for your account\\. This means (.+?) does not collect any of your prompts, content, or model responses, but will still collect general usage patterns \\(e\\.g\\., feature adoption, active user counts\\)\\.?$",
      "flags": "i",
      "sc": "您的账户已关闭遥测数据收集。这意味着 {1} 不会收集您的任何提示词、内容或模型回复，但仍会收集一般使用模式（例如功能采用率、活跃用户数）。",
      "tw": "您的帳戶已關閉遙測資料收集。這表示 {1} 不會收集您的任何提示詞、內容或模型回覆，但仍會收集一般使用模式（例如功能採用率、活躍使用者數）。"
    },
    {
      "id": "waiting-command-completion",
      "pattern": "^Waiting for command completion\\s*\\(up to (\\d+) seconds\\)$",
      "flags": "i",
      "sc": "正在等待命令完成（最多 {1} 秒）",
      "tw": "正在等待指令完成（最多 {1} 秒）"
    },
    {
      "id": "thinking-seconds-ellipsis",
      "pattern": "^Thinking \\((\\d+)s\\)\\.\\.\\.$",
      "flags": "i",
      "sc": "正在思考 ({1} 秒)...",
      "tw": "正在思考 ({1} 秒)..."
    },
    {
      "id": "still-thinking-seconds",
      "pattern": "^Still thinking,\\s*(\\d+) seconds$",
      "flags": "i",
      "sc": "仍在思考，{1} 秒",
      "tw": "仍在思考，{1} 秒"
    },
    {
      "id": "working-dot-seconds",
      "pattern": "^Working\\s*·\\s*(\\d+)s$",
      "flags": "i",
      "sc": "工作中 · {1} 秒",
      "tw": "工作中 · {1} 秒"
    },
    {
      "id": "daily-at-time",
      "pattern": "^Daily at\\s+(.+)$",
      "flags": "i",
      "sc": "每天 {1}",
      "tw": "每天 {1}"
    },
    {
      "id": "monthly-on-the-day-at-time",
      "pattern": "^Monthly on the\\s+(.+?)\\s+at\\s+(.+)$",
      "flags": "i",
      "sc": "每月 {1} {2}",
      "tw": "每月 {1} {2}"
    },
    {
      "id": "n-attachments-parens",
      "pattern": "^(\\d+)\\s+attachment\\(s\\)$",
      "flags": "i",
      "sc": "{1} 个附件",
      "tw": "{1} 個附件"
    },
    {
      "id": "n-archived-conversations",
      "pattern": "^(\\d+)\\s+archived conversations?$",
      "flags": "i",
      "sc": "{1} 个已归档会话",
      "tw": "{1} 個已封存對話"
    },
    {
      "id": "n-background-tasks",
      "pattern": "^(\\d+)\\s+background tasks?$",
      "flags": "i",
      "sc": "{1} 个后台任务",
      "tw": "{1} 個背景任務"
    },
    {
      "id": "n-browser-steps",
      "pattern": "^(\\d+)\\s+browser steps?$",
      "flags": "i",
      "sc": "{1} 个浏览器步骤",
      "tw": "{1} 個瀏覽器步驟"
    },
    {
      "id": "n-models-selected",
      "pattern": "^(\\d+)\\s+models?\\s+selected$",
      "flags": "i",
      "sc": "已选择 {1} 个模型",
      "tw": "已選取 {1} 個模型"
    },
    {
      "id": "n-waiting-on-you",
      "pattern": "^(\\d+)\\s+waiting on you$",
      "flags": "i",
      "sc": "{1} 项待您处理",
      "tw": "{1} 項待您處理"
    },
    {
      "id": "n-files-with-changes",
      "pattern": "^(\\d+)\\s+Files?\\s+With Changes$",
      "flags": "i",
      "sc": "{1} 个文件有更改",
      "tw": "{1} 個檔案有變更"
    },
    {
      "id": "n-lines-added-removed",
      "pattern": "^(\\d+)\\s+lines?\\s+added,\\s*(\\d+)\\s+lines?\\s+removed$",
      "flags": "i",
      "sc": "新增 {1} 行，删除 {2} 行",
      "tw": "新增 {1} 行，移除 {2} 行"
    },
    {
      "id": "n-tasks-running",
      "pattern": "^(\\d+)\\s+tasks?\\s+running$",
      "flags": "i",
      "sc": "{1} 个任务运行中",
      "tw": "{1} 個任務執行中"
    },
    {
      "id": "n-mcp-servers-failed",
      "pattern": "^(\\d+)\\s+MCP servers? failed to start$",
      "flags": "i",
      "sc": "{1} 个 MCP 服务器启动失败",
      "tw": "{1} 個 MCP 伺服器啟動失敗"
    },
    {
      "id": "added-mcp-server-failed",
      "pattern": "^Added MCP server \"(.+?)\",\\s*but it failed to start:\\s*(.+)$",
      "flags": "i",
      "sc": "已添加 MCP 服务器“{1}”，但启动失败：{2}",
      "tw": "已新增 MCP 伺服器「{1}」，但啟動失敗：{2}"
    },
    {
      "id": "mcp-server-auth-account",
      "pattern": "^MCP server (.+?) requires authentication:\\s*sign in to \"(.+?)\" in the Accounts section of plugin \"(.+?)\"$",
      "flags": "i",
      "sc": "MCP 服务器 {1} 需要身份验证：请在“{3}”插件的“账户”部分登录“{2}”",
      "tw": "MCP 伺服器 {1} 需要身分驗證：請在「{3}」外掛程式的「帳戶」區段中登入「{2}」"
