  "dynamicRules": [
    {
      "id": "offload-routine-steps-faster-executor-full",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?faster executor\\.\\s*Same\\s+quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "zhPeriod" },
      "sc": "将常规步骤分流至更快的执行模型。保持同等质量，消耗更少 Token{1}",
      "tw": "將例行步驟分流至更快的執行模型。維持相同品質，消耗更少 Token{1}"
    },
    {
      "id": "offload-routine-steps-model-quality-full",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?(.+?)\\.\\s*Same\\s+(.+?)(?:-level)?\\s+quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "trim", "3": "zhPeriod" },
      "sc": "将常规步骤分流至 {1}。保持 {2} 同级质量，消耗更少 Token{3}",
      "tw": "將例行步驟分流至 {1}。維持 {2} 同級品質，消耗更少 Token{3}"
    },
    {
      "id": "offload-routine-steps-faster-executor-short",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?faster executor(\\.?)$",
      "flags": "i",
      "transforms": { "1": "zhPeriod" },
      "sc": "将常规步骤分流至更快的执行模型{1}",
      "tw": "將例行步驟分流至更快的執行模型{1}"
    },
    {
      "id": "offload-routine-steps-short",
      "pattern": "^Offloads routine steps to\\s+(?:a\\s+)?(.+?)(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "zhPeriod" },
      "sc": "将常规步骤分流至 {1}{2}",
      "tw": "將例行步驟分流至 {1}{2}"
    },
    {
      "id": "same-quality-fewer-tokens",
      "pattern": "^Same quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "zhPeriod" },
      "sc": "保持同等质量，消耗更少 Token{1}",
      "tw": "維持相同品質，消耗更少 Token{1}"
    },
    {
      "id": "model-may-offload-quality-full",
      "pattern": "^(.+?)\\s+that may offload routine steps to\\s+(.+?)\\.\\s*Same\\s+(.+?)-level quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "trim", "3": "trim", "4": "zhPeriod" },
      "sc": "{1} 可将例行步骤分流至 {2}。维持 {3} 同级质量，消耗更少 Token{4}",
      "tw": "{1} 可將例行步驟分流至 {2}。維持 {3} 同級品質，消耗更少 Token{4}"
    },
    {
      "id": "model-may-offload-short",
      "pattern": "^(.+?)\\s+that may offload routine steps to\\s+(.+?)(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "trim", "3": "zhPeriod" },
      "sc": "{1} 可将例行步骤分流至 {2}{3}",
      "tw": "{1} 可將例行步驟分流至 {2}{3}"
    },
    {
      "id": "same-model-level-quality",
      "pattern": "^Same\\s+(.+?)-level quality,\\s*fewer tokens used(\\.?)$",
      "flags": "i",
      "transforms": { "1": "trim", "2": "zhPeriod" },
      "sc": "维持 {1} 同级质量，消耗更少 Token{2}",
      "tw": "維持 {1} 同級品質，消耗更少 Token{2}"
    },
    {
      "id": "detached-at-sha",
      "pattern": "^Detached at\\s+([0-9a-f]{6,40})$",
      "flags": "i",
      "sc": "已分离于 {1}",
      "tw": "已分離於 {1}"
    },
    {
      "id": "voice-speed",
      "pattern": "^Voice\\s+speed,\\s+(.+)$",
      "flags": "i",
      "sc": "语速，{1}",
      "tw": "語速，{1}"
    },
    {
      "id": "couldn-t-disconnect",
      "pattern": "^Couldn['’]t disconnect\\s+(.+?):\\s*(.+)$",
      "flags": "i",
      "sc": "无法断开 {1} 的连接：{2}",
      "tw": "無法中斷 {1} 的連線：{2}"
    },
    {
      "id": "failed-to-load-page",
      "pattern": "^Failed to load page\\s+(.+?):\\s*(.+)$",
      "flags": "i",
      "sc": "加载页面 {1} 失败：{2}",
      "tw": "載入頁面 {1} 失敗：{2}"
    },
    {
      "id": "more-options-for",
      "pattern": "^More options for\\s+(.+)$",
      "flags": "i",
      "sc": "{1} 的更多选项",
      "tw": "{1} 的更多選項"
    },
    {
      "id": "opens-new-conv-screen",
      "pattern": "^Opens the New Conversation screen for this\\s+(.+)$",
      "flags": "i",
      "transforms": { "1": "lookupOrKeep" },
      "sc": "打开此 {1} 的新会话界面",
      "tw": "開啟此 {1} 的新對話畫面"
    },
    {
      "id": "plus-n-attachments",
      "pattern": "^\\+(\\d+)\\s+attachments?$",
      "flags": "i",
      "sc": "另有 {1} 个附件",
      "tw": "另有 {1} 個附件"
    },
    {
      "id": "branch-current",
      "pattern": "^Branch,\\s*current:\\s*(.+)$",
      "flags": "i",
      "sc": "当前分支：{1}",
      "tw": "目前分支：{1}"
    },
    {
      "id": "github-prefix",
      "pattern": "^GitHub:\\s*(.+)$",
      "flags": "i",
      "sc": "GitHub：{1}",
      "tw": "GitHub：{1}"
    },
    {
      "id": "ssh-prefix",
      "pattern": "^SSH:\\s*(.+)$",
      "flags": "i",
      "sc": "SSH：{1}",
      "tw": "SSH：{1}"
    },
    {
      "id": "script-timed-out",
      "pattern": "^script timed out after\\s+(\\d+)\\s*ms$",
      "flags": "i",
      "sc": "脚本于 {1} 毫秒后超时",
      "tw": "指令碼於 {1} 毫秒後逾時"
    },
    {
      "id": "select-model-current",
      "pattern": "^Select model,\\s*current:\\s*(.+)$",
      "flags": "i",
      "sc": "选择模型，当前：{1}",
      "tw": "選擇模型，目前：{1}"
    },
    {
      "id": "select-project-current",
      "pattern": "^Select project,\\s*current:\\s*(.+)$",
      "flags": "i",
      "sc": "选择项目，当前：{1}",
      "tw": "選擇專案，目前：{1}"
    },
    {
      "id": "stop-n-selected",
      "pattern": "^Stop\\s+(\\d+)\\s+selected$",
      "flags": "i",
      "sc": "停止已选中的 {1} 个项目",
      "tw": "停止已選取的 {1} 個項目"
    }
  ],
